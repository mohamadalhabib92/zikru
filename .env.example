# Copier vers .env et remplacer les valeurs YOUR_* (ne jamais committer .env).
# Toute valeur absente ou commençant par « YOUR_ » est traitée comme « non configurée » : l'app reste
# en mode local, sans crash (src/lib/config.ts).

# --- Client (public, embarqué dans l'app) ---
# L'app contient déjà l'URL et la clé publique (publishable) du projet Zikru ;
# ces variables permettent de pointer vers un autre projet. Ne JAMAIS mettre de clé service_role ici.
EXPO_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Optionnel : URL https d'un fichier audio d'adhan dont vous détenez les droits
EXPO_PUBLIC_ADHAN_AUDIO_URL=YOUR_ADHAN_AUDIO_URL

# --- Serveur uniquement (secrets Supabase → Edge Functions, JAMAIS dans l'app) ---
# BILAL_AI_API_KEY=YOUR_BILAL_AI_API_KEY

# --- Décisions éditoriales à fournir (valeurs reprises dans src/lib/app-placeholders.ts) ---
# Méthode de calcul des prières par défaut (clé de METHODS, ex. MuslimWorldLeague, UOIF…)
# YOUR_DEFAULT_PRAYER_METHOD
# Licences des traductions du Coran affichées
# YOUR_QURAN_TRANSLATIONS_LICENSES
# Nom du savant validateur (aucun badge « validé » sans signature réelle)
# YOUR_SCHOLAR_VALIDATOR_NAME
# Adresse de contact du support
# YOUR_SUPPORT_EMAIL
