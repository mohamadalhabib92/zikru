# Copier vers .env et remplacer les valeurs YOUR_* (ne jamais committer .env).
# Supabase : l'app contient déjà l'URL et la clé publique (publishable) du projet Zikru ;
# ces variables permettent de pointer vers un autre projet. Ne jamais mettre de clé service_role ici.
EXPO_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Optionnel : URL https d'un fichier audio d'adhan dont vous détenez les droits
EXPO_PUBLIC_ADHAN_AUDIO_URL=YOUR_ADHAN_AUDIO_URL
