# Copier vers .env et remplacer les valeurs YOUR_* (ne jamais committer .env).
# Aucune valeur réelle dans ce fichier. Sans ces variables, le cœur de l'app reste local.
EXPO_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Optionnel. Désactivé si absent ou YOUR_*.
EXPO_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN
# Optionnel : URL https d'un fichier audio d'adhan dont vous détenez les droits.
EXPO_PUBLIC_ADHAN_AUDIO_URL=YOUR_ADHAN_AUDIO_URL
# À trancher par Mohamed. Tant que la valeur est YOUR_* ou inconnue, repli technique Muslim World League (pas une norme officielle suisse).
# EXPO_PUBLIC_DEFAULT_PRAYER_METHOD=YOUR_DEFAULT_PRAYER_METHOD
# Placeholders non lus par le client (ne pas inventer de valeur) :
# YOUR_QURAN_TRANSLATIONS_LICENSES
# YOUR_SCHOLAR_VALIDATOR_NAME
# YOUR_SUPPORT_EMAIL
# Serveur uniquement, jamais dans le bundle :
# BILAL_AI_API_KEY=YOUR_BILAL_AI_API_KEY
