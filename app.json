{
  "expo": {
    "name": "Zikru",
    "slug": "zikru",
    "scheme": "zikru",
    "version": "1.0.25",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "description": "Zikru — prière, qibla, tasbih et dhikr, hors-ligne.",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F3D30"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vibecode.zikru-76mpdv",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Zikru utilise le Bluetooth pour se connecter à votre compteur de tasbih ou anneau de dhikr et compter chaque appui.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "fr",
        "NSLocationWhenInUseUsageDescription": "Zikru utilise votre position pour calculer sur l’appareil les horaires de prière et la qibla. Si vous activez la météo, une position arrondie (≈ 10 km) est envoyée à Open-Meteo (Suisse). Aucun suivi publicitaire.",
        "NSMotionUsageDescription": "Cette app n'utilise pas les données de mouvement ; cette mention est requise par le module de localisation.",
        "NSLocationTemporaryUsageDescriptionDictionary": {
          "ExpoLocationFullAccuracy": "La position précise permet un résultat plus exact."
        },
        "NSCameraUsageDescription": "Zikru utilise l’appareil photo seulement si vous photographiez un zikr : le texte est reconnu sur votre téléphone et la photo reste sur l’appareil, sans envoi.",
        "NSPhotoLibraryUsageDescription": "Zikru accède à la photo que vous choisissez pour en reconnaître le texte sur l’appareil. Rien n’est envoyé."
      },
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
