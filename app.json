      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "Zikru",
      "shortName": "Zikru",
      "themeColor": "#0F3D30",
      "backgroundColor": "#0F3D30",
      "lang": "fr"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "neverForLocation": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Zikru utilise le Bluetooth pour se connecter à votre compteur de tasbih ou anneau de dhikr et compter chaque appui."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Zikru utilise votre position pour calculer sur l’appareil les horaires de prière et la qibla. Si vous activez la météo, une position arrondie (≈ 10 km) est envoyée à Open-Meteo (Suisse). Aucun suivi publicitaire.",
          "locationAlwaysAndWhenInUsePermission": "Zikru utilise votre position pour calculer sur l’appareil les horaires de prière et la qibla. Si vous activez la météo, une position arrondie (≈ 10 km) est envoyée à Open-Meteo (Suisse). Aucun suivi publicitaire.",
          "locationAlwaysPermission": "Zikru utilise votre position pour calculer sur l’appareil les horaires de prière et la qibla. Si vous activez la météo, une position arrondie (≈ 10 km) est envoyée à Open-Meteo (Suisse). Aucun suivi publicitaire.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Zikru accède à la photo que vous choisissez pour en reconnaître le texte sur l’appareil. Rien n’est envoyé.",
          "cameraPermission": "Zikru utilise l’appareil photo seulement si vous photographiez un zikr : le texte est reconnu sur votre téléphone et la photo reste sur l’appareil, sans envoi.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/zikru"
    },
    "owner": "habib548",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
